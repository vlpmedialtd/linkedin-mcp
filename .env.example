# Option A: provide an access token directly
LINKEDIN_ACCESS_TOKEN=

# Option B: run `npx linkedin-mcp auth` once (needs client id + secret),
# the token is then stored in ~/.config/linkedin-mcp/token.json
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must be registered in your LinkedIn app under "Authorized redirect URLs"
LINKEDIN_REDIRECT_URI=http://localhost:8787/callback
# Space-separated scopes. Add w_organization_social r_organization_social rw_organization_admin
# if your app has the Community Management API product.
LINKEDIN_SCOPES=openid profile email w_member_social

# Optional
LINKEDIN_API_VERSION=202608
LINKEDIN_TOKEN_FILE=
